// Install with `hk install --mise` so hook execution resolves mise-managed tools
// Skip with `HK=0` or `git ... --no-verify`
//
// `amends`/`import` must be the first module members and cannot interpolate a
// pkl `local`, so the version literal is repeated in all three places below.

amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

min_hk_version = "1.54.0"

// Verbatim GPL text: mdformat rewrites its hanging indents into code fences
exclude = List("LICENSE.md")

// Builtins carry a `check_diff`, so a clean file is never rewritten and hk
// stages exactly the files each step touched (`stage = "<JOB_FILES>"` default).
local linters = new Mapping<String, Step> {
    ["byte-order-marker"] = Builtins.byte_order_marker
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-symlinks"] = Builtins.check_symlinks
    // hk ships no equivalent of pre-commit's check-vcs-permalinks, so this
    // reproduces the part that matters for these docs: a GitHub line link is
    // only stable when pinned to a full commit sha.
    // `hk builtins | grep -i vcs` on a future upgrade is the cheapest way to
    // notice if a builtin arrives.
    ["check-vcs-permalinks"] {
        types = List("text")
        check = """
            if grep -nEI 'https://github\\.com/[^/ ]+/[^/ ]+/blob/[^ ]*#L[0-9]' {{ files }} | grep -vE '/blob/[0-9a-f]{40}/'; then
                echo 'Pin GitHub line links to a full commit sha, not a branch name'
                exit 1
            fi
            """
    }
    ["detect-private-key"] = Builtins.detect_private_key
    // Replaces pre-commit's pretty-format-json: 4-space indent and sorted keys,
    // where the stock builtin would reindent every JSON file to 2 spaces.
    ["jq"] = (Builtins.jq) {
        // vim.pack owns this lockfile's format and rewrites it on launch
        exclude = List("nvim-pack-lock.json")
        check_diff = """
            failed=0
            for f in {{ files }}; do
                jq --indent 4 -S . "$f" | diff -u "$f" - || failed=1
            done
            exit $failed
            """
        fix = """
            for f in {{ files }}; do
                tmp=$(mktemp) && jq --indent 4 -S . "$f" >"$tmp" && mv "$tmp" "$f"
            done
            """
    }
    // doc/src/ is excluded because panvimdoc, not a reader, consumes it, and
    // mdformat's rewrites change what the generated vimdoc looks like.
    // BENCHMARKS.md is an append-only measurement log.
    ["mdformat"] {
        glob = List("**/*.md")
        exclude = List("doc/src/**", "BENCHMARKS.md", "CODE_TAG_SUMMARY.md")
        check = "uvx --from 'mdformat==1.0.0' --with 'mdformat-mkdocs[recommended]>=2.0.6' --with 'mdformat-gfm-alerts>=0.0.1' mdformat --wrap=no --check {{files}}"
        fix = "uvx --from 'mdformat==1.0.0' --with 'mdformat-mkdocs[recommended]>=2.0.6' --with 'mdformat-gfm-alerts>=0.0.1' mdformat --wrap=no {{files}}"
    }
    ["mixed-line-ending"] = Builtins.mixed_line_ending
    ["newlines"] = Builtins.newlines
    // JSON is left to the jq step above (4-space) and markdown to mdformat, so
    // prettier keeps only the formats neither one owns.
    ["prettier"] = (Builtins.prettier) {
        glob = List("**/*.html", "**/*.js", "**/*.yaml", "**/*.yml")
    }
    ["selene"] = Builtins.selene
    // Replaces prettier-plugin-sh; picks up shell files by extension or shebang
    ["shfmt"] = Builtins.shfmt
    ["stylua"] = Builtins.stylua
    // Matches the tombi LSP that formats TOML on save, so the editor and the
    // hook agree, and it subsumes pre-commit's check-toml parse check.
    // `Builtins.tombi` (the linter) is deliberately absent: it validates against
    // Schema Store and rejects valid-but-unschema'd keys.
    ["tombi-format"] = Builtins.tombi_format
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        // Generated by panvimdoc, which pads its own alignment columns
        exclude = List("doc/kyleking-neovim.txt")
    }
    // Restores the parse check that check-yaml gave us. The relaxed ruleset is
    // deliberate and must stay unstrict: it demotes style rules to warnings so
    // only unparseable YAML fails.
    ["yamllint"] = (Builtins.yamllint) {
        check = "yamllint -d relaxed {{files}}"
    }
}

// Generated documentation. Each step writes files it was not handed, so the
// chain is ordered with `depends` and only the tracked output is staged
// (doc/generated/ and doc/tags are gitignored).
local codegen = new Mapping<String, Step> {
    ["generate-plugin-docs"] {
        glob = List("lua/tests/docs/**/*.lua")
        check = "mise run doc:plugin"
    }
    ["helptags"] {
        glob = List("doc/kyleking-neovim.txt")
        depends = List("panvimdoc")
        check = null
        fix = "mise run doc:helptags"
    }
    ["panvimdoc"] {
        glob = List("doc/src/**/*.md", "lua/tests/docs/**/*.lua")
        depends = List("generate-plugin-docs")
        check = null
        fix = "mise run doc:vimdoc"
        stage = List("doc/kyleking-neovim.txt")
    }
}

local commit_msg_checks = new Mapping<String, Step> {
    ["check-conventional-commit"] = Builtins.check_conventional_commit
}

// Slow enough to belong on push rather than on every commit
local pre_push_checks = new Mapping<String, Step> {
    ["lua-diagnostics"] {
        glob = List("**/*.lua")
        check = "mise run lint:lua"
    }
    ["measure-startup"] {
        glob = List("init.lua", "lua/kyleking/**/*.lua", "lsp/**/*.lua")
        check = "mise run measure"
    }
    ["mini-test"] {
        glob = List("**/*.lua")
        check = "mise run test"
    }
}

hooks = new {
    ["pre-commit"] {
        fix = true
        stash = "patch-file"
        steps = new {
            ...codegen
            ...linters
        }
    }
    ["pre-push"] {
        steps = new {
            ...pre_push_checks
            ...linters
        }
    }
    ["commit-msg"] {
        steps = commit_msg_checks
    }

    // "fix" and "check" back the `hk fix` and `hk check` commands
    ["fix"] {
        fix = true
        steps = new {
            ...codegen
            ...linters
        }
    }
    ["check"] {
        steps = new {
            ...pre_push_checks
            ...linters
        }
    }
}
